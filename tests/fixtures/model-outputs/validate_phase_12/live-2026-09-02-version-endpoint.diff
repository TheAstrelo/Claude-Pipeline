@@ -0,0 +1,13 @@
+const { Router } = require('express');
+const router = Router();
+const { version } = require('../../package.json');
+
+/**
+ * @route GET /api/version
+ * @returns {object} Current application version
+ */
+router.get('/', (req, res) => {
+  res.json({ version });
+});
+
+module.exports = router;
